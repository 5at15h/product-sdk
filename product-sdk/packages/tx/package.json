{
    "name": "@parity/product-sdk-tx",
    "version": "0.5.10",
    "description": "Transaction submission, lifecycle watching, and dev signers for Polkadot chains",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": ["dist", "src"],
    "scripts": {
        "build": "tsup",
        "test": "vitest",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "test:commons-registry": "node qualification/commons-registry.mjs"
    },
    "dependencies": {
        "@parity/product-sdk-keys": "workspace:*",
        "@parity/product-sdk-logger": "workspace:*",
        "@parity/product-sdk-errors": "workspace:*",
        "@parity/result": "workspace:*",
        "@polkadot-labs/hdkd-helpers": "catalog:",
        "@polkadot-api/signers-common": "catalog:",
        "polkadot-api": "catalog:",
        "@polkadot-api/metadata-builders": "catalog:",
        "@polkadot-api/substrate-bindings": "catalog:",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    },
    "license": "Apache-2.0"
}
